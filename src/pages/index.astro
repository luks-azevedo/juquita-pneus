---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/sections/Hero.astro';
import StripeBand from '../components/sections/StripeBand.astro';
import ServicesSection from '../components/sections/ServicesSection.astro';
import AboutSection from '../components/sections/AboutSection.astro';
import BenefitsSection from '../components/sections/BenefitsSection.astro';
import VisitSection from '../components/sections/VisitSection.astro';
import FAQSection from '../components/sections/FAQSection.astro';
import CTASection from '../components/sections/CTASection.astro';
import { photos, services, steps, faq } from '../data/juquita';
import { whatsappMessages } from '../config/site';
import { whatsappUrl } from '../lib/contact';

const agendar = whatsappUrl(whatsappMessages.agendar) ?? '/contato';
const orcamentoPneus = whatsappUrl(whatsappMessages.pneus) ?? '/contato';
const homeServices = services.map((s) => ({ ...s, href: `/servicos#${s.id}` }));
---

<BaseLayout>
  <Hero
    variant="cover"
    eyebrow="Conselheiro Lafaiete · desde 1957"
    title="Pneus, freios, suspensão e mecânica."
    description="Centro automotivo completo no bairro Santa Matilde. Agende o serviço do seu carro pelo WhatsApp."
    primaryCta={{ label: 'Agendar pelo WhatsApp', href: agendar }}
    secondaryCta={{ label: 'Ver serviços', href: '/servicos' }}
    image={photos.hero}
  />

  <StripeBand lead="Desde 1957" items={['Pneus', 'Freios', 'Suspensão', 'Mecânica']} />

  <ServicesSection
    eyebrow="Serviços"
    title="Tudo para o seu carro em um só lugar"
    description="Do alinhamento à revisão completa: os principais serviços do dia a dia, com hora marcada."
    items={homeServices}
    cta={{ label: 'Todos os serviços', href: '/servicos' }}
  />

  <AboutSection
    tone="muted"
    eyebrow="A Juquita"
    title="Tradição em Conselheiro Lafaiete"
    paragraphs={[
      'Desde 1957, a Juquita Pneus faz parte do dia a dia de quem roda pela cidade.',
      'Hoje, o centro automotivo reúne pneus, freios, suspensão e mecânica no bairro Santa Matilde, com atendimento de segunda a sexta e agendamento pelo WhatsApp.',
    ]}
    image={photos.mecanico}
    cta={{ label: 'Conheça a Juquita', href: '/sobre' }}
  />

  <BenefitsSection id="como-funciona" eyebrow="Como funciona" title="Agendou, chegou, resolveu" items={steps} variant="numbered" />

  <CTASection
    title="Precisa de pneus novos?"
    description="Mande o modelo do carro ou a medida do pneu pelo WhatsApp e receba o orçamento."
    primaryCta={{ label: 'Pedir orçamento de pneus', href: orcamentoPneus }}
    secondaryCta={{ label: 'Outros serviços', href: '/servicos' }}
  />

  <VisitSection
    eyebrow="Visite"
    title="Horário e endereço"
    description="No bairro Santa Matilde, em Conselheiro Lafaiete."
    whatsappMessage={whatsappMessages.agendar}
    whatsappLabel="Agendar pelo WhatsApp"
  />

  <FAQSection tone="muted" eyebrow="Dúvidas" title="Perguntas frequentes" items={faq} />
</BaseLayout>
