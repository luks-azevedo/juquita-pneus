---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/sections/Hero.astro';
import AboutSection from '../components/sections/AboutSection.astro';
import GallerySection from '../components/sections/GallerySection.astro';
import CTASection from '../components/sections/CTASection.astro';
import { photos, gallery } from '../data/juquita';
import { whatsappMessages } from '../config/site';
import { whatsappUrl } from '../lib/contact';

const agendar = whatsappUrl(whatsappMessages.agendar) ?? '/contato';
---

<BaseLayout
  title="Sobre"
  description="A Juquita Pneus é um centro automotivo em Conselheiro Lafaiete desde 1957. Pneus, freios, suspensão e mecânica."
>
  <Hero
    variant="page"
    eyebrow="Sobre"
    title="Centro automotivo desde 1957"
    description="Uma oficina de Conselheiro Lafaiete com pneus, freios, suspensão e mecânica em um só lugar."
  />

  <AboutSection
    id="historia"
    eyebrow="A Juquita"
    title="Tradição que segue rodando"
    paragraphs={[
      'A Juquita Pneus está em Conselheiro Lafaiete desde 1957.',
      'No bairro Santa Matilde, o centro automotivo reúne serviços de pneus, freios, suspensão e mecânica.',
      'O atendimento é de segunda a sexta, das 7h45 às 18h, com agendamento pelo WhatsApp.',
    ]}
    image={photos.fachada}
    imagePosition="right"
  />

  <GallerySection tone="muted" eyebrow="A oficina" title="Por dentro da Juquita" images={gallery} />

  <CTASection
    title="Bora cuidar do seu carro?"
    description="Agende o serviço pelo WhatsApp."
    primaryCta={{ label: 'Agendar pelo WhatsApp', href: agendar }}
    secondaryCta={{ label: 'Ver serviços', href: '/servicos' }}
  />
</BaseLayout>
