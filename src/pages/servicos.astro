---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/sections/Hero.astro';
import ServicesSection from '../components/sections/ServicesSection.astro';
import BenefitsSection from '../components/sections/BenefitsSection.astro';
import CTASection from '../components/sections/CTASection.astro';
import { services, steps } from '../data/juquita';
import { whatsappMessages } from '../config/site';
import { whatsappUrl } from '../lib/contact';

const agendar = whatsappUrl(whatsappMessages.agendar) ?? '/contato';
---

<BaseLayout
  title="Serviços"
  description="Pneus, alinhamento, balanceamento, freios, suspensão, direção e mecânica em Conselheiro Lafaiete. Agende pelo WhatsApp."
>
  <Hero
    variant="page"
    eyebrow="Serviços"
    title="Pneus, freios, suspensão e mecânica"
    description="Os serviços do centro automotivo, com agendamento pelo WhatsApp."
    primaryCta={{ label: 'Agendar pelo WhatsApp', href: agendar }}
  />

  <ServicesSection id="lista-servicos" title="O que fazemos" items={services} variant="list" />

  <BenefitsSection tone="muted" id="como-funciona" eyebrow="Atendimento" title="Como funciona" items={steps} variant="numbered" />

  <CTASection
    title="Não encontrou o que procura?"
    description="Fale com a equipe pelo WhatsApp e conte o que o seu carro precisa."
    primaryCta={{ label: 'Falar pelo WhatsApp', href: agendar }}
    secondaryCta={{ label: 'Horário e endereço', href: '/contato' }}
  />
</BaseLayout>
