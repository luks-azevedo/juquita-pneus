---
import Logo from './Logo.astro';
import { site } from '../../config/site';
import { navigation } from '../../config/navigation';
import { whatsappUrl, phoneUrl, emailUrl, formatPhone, formattedAddress, socialLinks } from '../../lib/contact';

const year = new Date().getFullYear();
const wa = whatsappUrl();
const tel = phoneUrl();
const mail = emailUrl();
const address = formattedAddress();
const socials = socialLinks();
const legal = [site.legalName, site.cnpj && `CNPJ ${site.cnpj}`].filter(Boolean).join(' · ');
const hasContact = Boolean(wa || tel || mail || address || site.contact.hours);
---

<footer class="border-t border-inverted-ink/15 bg-inverted text-inverted-ink">
  <div class="container-page grid gap-12 py-16 md:grid-cols-12 lg:py-20">
    <div class="md:col-span-5">
      <a href="/" class="inline-block">
        <Logo inverted />
        <span class="sr-only"> — página inicial</span>
      </a>
      <p class="mt-5 max-w-sm text-inverted-ink/90">{site.description}</p>
      {
        socials.length > 0 && (
          <ul class="mt-6 flex flex-wrap gap-x-5 gap-y-2 text-sm">
            {socials.map((s) => (
              <li>
                <a href={s.href} target="_blank" rel="noopener noreferrer" class="underline-offset-4 hover:underline">
                  {s.label}
                  <span class="sr-only"> (abre em nova aba)</span>
                </a>
              </li>
            ))}
          </ul>
        )
      }
    </div>

    <div class="grid gap-10 sm:grid-cols-3 md:col-span-7">
    {
      navigation.footer.map((group) => (
        <nav aria-label={group.title}>
          <p class="text-sm font-medium text-inverted-ink/90">{group.title}</p>
          <ul class="mt-4 space-y-2.5">
            {group.links.map((l) => (
              <li>
                <a href={l.href} class="underline-offset-4 hover:underline">
                  {l.label}
                </a>
              </li>
            ))}
          </ul>
        </nav>
      ))
    }

    {
      hasContact && (
        <div>
          <p class="text-sm font-medium text-inverted-ink/90">Contato</p>
          <ul class="mt-4 space-y-2.5">
            {wa && (
              <li>
                <a href={wa} target="_blank" rel="noopener noreferrer" class="underline-offset-4 hover:underline">
                  WhatsApp {formatPhone(site.contact.whatsapp)}
                </a>
              </li>
            )}
            {tel && (
              <li>
                <a href={tel} class="underline-offset-4 hover:underline">
                  {formatPhone(site.contact.phone)}
                </a>
              </li>
            )}
            {mail && (
              <li>
                <a href={mail} class="break-all underline-offset-4 hover:underline">
                  {site.contact.email}
                </a>
              </li>
            )}
            {address && <li class="text-inverted-ink/90">{address}</li>}
            {site.contact.hours && <li class="text-inverted-ink/90">{site.contact.hours}</li>}
          </ul>
        </div>
      )
    }
    </div>
  </div>

  <div class="container-page flex flex-col gap-2 border-t border-inverted-ink/15 py-6 text-sm text-inverted-ink/90 sm:flex-row sm:justify-between">
    <p>© {year} {site.name}. Todos os direitos reservados.</p>
    {legal && <p>{legal}</p>}
  </div>
</footer>
