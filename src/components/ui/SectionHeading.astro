---
/** Título de seção com rótulo (eyebrow) e descrição opcionais. */
interface Props {
  id?: string;
  eyebrow?: string;
  title: string;
  description?: string;
  align?: 'left' | 'center';
  /** Nível do título (h1 apenas no topo da página). */
  as?: 'h1' | 'h2' | 'h3';
  /** Ajusta cores para seções com tone="inverted". */
  inverted?: boolean;
  class?: string;
}

const {
  id,
  eyebrow,
  title,
  description,
  align = 'left',
  as: Heading = 'h2',
  inverted = false,
  class: className,
} = Astro.props;
---

<div class:list={['max-w-2xl', align === 'center' && 'mx-auto text-center', className]}>
  {
    eyebrow && (
      <p
        class:list={[
          'mb-4 text-sm font-medium tracking-[0.08em] uppercase',
          inverted ? 'text-inverted-ink/80' : 'text-accent',
        ]}
      >
        {eyebrow}
      </p>
    )
  }
  <Heading id={id} class:list={[Heading === 'h1' ? 'text-display' : 'text-h2']}>
    {title}
  </Heading>
  {
    description && (
      <p class:list={['text-lead mt-5', inverted ? 'text-inverted-ink/85' : 'text-muted']}>{description}</p>
    )
  }
  <slot />
</div>
