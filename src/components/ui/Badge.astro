---
/** Rótulo curto. Use tone="notice" para identificar conteúdo ilustrativo. */
interface Props {
  tone?: 'neutral' | 'accent' | 'notice';
  class?: string;
}
const { tone = 'neutral', class: className } = Astro.props;

const tones = {
  neutral: 'border-line bg-surface text-muted',
  accent: 'border-transparent bg-primary text-primary-contrast',
  notice: 'border-dashed border-muted/50 bg-transparent text-muted',
};
---

<span
  class:list={[
    'inline-flex items-center gap-1.5 rounded-control border px-2.5 py-1 text-xs font-medium leading-none',
    tones[tone],
    className,
  ]}
>
  <slot />
</span>
