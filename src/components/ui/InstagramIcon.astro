---
/** Ícone do Instagram em traço (mesmo estilo dos ícones Lucide). */
interface Props {
  size?: number;
  class?: string;
}
const { size = 20, class: className } = Astro.props;
---

<svg
  xmlns="http://www.w3.org/2000/svg"
  width={size}
  height={size}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="2"
  stroke-linecap="round"
  stroke-linejoin="round"
  class={className}
  aria-hidden="true"
>
  <rect x="2" y="2" width="20" height="20" rx="5.5"></rect>
  <circle cx="12" cy="12" r="4.2"></circle>
  <circle cx="17.6" cy="6.4" r="0.9" fill="currentColor" stroke="none"></circle>
</svg>
