---
/**
 * Abertura de página.
 * - variant="split"    → texto + imagem lado a lado (home)
 * - variant="centered" → texto centralizado, imagem larga opcional abaixo
 * - variant="page"     → cabeçalho compacto para páginas internas
 */
import { Image } from 'astro:assets';
import Check from '@lucide/astro/icons/check';
import ArrowRight from '@lucide/astro/icons/arrow-right';
import Button from '../ui/Button.astro';
import Container from '../ui/Container.astro';
import Badge from '../ui/Badge.astro';
import type { ContentImage, CTA } from '../../types/content';

interface Props {
  variant?: 'split' | 'centered' | 'page';
  eyebrow?: string;
  title: string;
  description?: string;
  primaryCta?: CTA;
  secondaryCta?: CTA;
  image?: ContentImage;
  /** Marca a imagem como ilustrativa (exibe um selo). */
  imageIllustrative?: boolean;
  /** Lista curta de pontos (ex.: "Atendimento online"). */
  highlights?: string[];
}

const {
  variant = 'split',
  eyebrow,
  title,
  description,
  primaryCta,
  secondaryCta,
  image,
  imageIllustrative = false,
  highlights = [],
} = Astro.props;

const isSplit = variant === 'split' && image;
const isCentered = variant === 'centered';
const isPage = variant === 'page';
---

<section
  class:list={[
    'relative',
    isPage ? 'border-b border-line pt-14 pb-12 lg:pt-20 lg:pb-16' : 'pt-12 pb-16 lg:pt-20 lg:pb-24',
  ]}
  aria-labelledby="page-title"
>
  <Container>
    <div class:list={[isSplit && 'grid items-center gap-12 lg:grid-cols-12 lg:gap-16']}>
      <div class:list={[isSplit && 'lg:col-span-7', isCentered && 'mx-auto max-w-3xl text-center', isPage && 'max-w-3xl']}>
        {eyebrow && <p class="mb-5 text-sm font-medium tracking-[0.08em] text-accent uppercase">{eyebrow}</p>}
        <h1 id="page-title" class:list={[isPage ? 'text-h2 sm:text-[clamp(2.25rem,1.6rem+2.4vw,3.5rem)]' : 'text-display']}>
          {title}
        </h1>
        {description && <p class:list={['text-lead mt-6 text-muted', isCentered ? 'mx-auto max-w-2xl' : 'max-w-xl']}>{description}</p>}

        {
          (primaryCta || secondaryCta) && (
            <div class:list={['mt-9 flex flex-col gap-3 sm:flex-row', isCentered && 'sm:justify-center']}>
              {primaryCta && (
                <Button href={primaryCta.href} size="lg" icon={ArrowRight}>
                  {primaryCta.label}
                </Button>
              )}
              {secondaryCta && (
                <Button href={secondaryCta.href} size="lg" variant="secondary">
                  {secondaryCta.label}
                </Button>
              )}
            </div>
          )
        }

        {
          highlights.length > 0 && (
            <ul class:list={['mt-10 flex flex-wrap gap-x-6 gap-y-3 text-sm text-muted', isCentered && 'justify-center']}>
              {highlights.map((h) => (
                <li class="flex items-center gap-2">
                  <Check size={16} class="text-primary" aria-hidden="true" />
                  {h}
                </li>
              ))}
            </ul>
          )
        }
      </div>

      {
        isSplit && image && (
          <figure class="relative lg:col-span-5">
            <Image
              src={image.src}
              alt={image.alt}
              widths={[480, 720, 960]}
              sizes="(min-width: 1024px) 40vw, 100vw"
              loading="eager"
              fetchpriority="high"
              class="aspect-[4/5] w-full rounded-card object-cover"
            />
            {imageIllustrative && <Badge tone="neutral" class="absolute top-4 left-4">Imagem ilustrativa</Badge>}
          </figure>
        )
      }
    </div>

    {
      isCentered && image && (
        <figure class="relative mt-14 lg:mt-20">
          <Image
            src={image.src}
            alt={image.alt}
            widths={[640, 1024, 1440]}
            sizes="100vw"
            loading="eager"
            class="aspect-[16/9] w-full rounded-card object-cover sm:aspect-[21/9]"
          />
          {imageIllustrative && <Badge class="absolute top-4 left-4">Imagem ilustrativa</Badge>}
        </figure>
      )
    }
  </Container>
</section>
