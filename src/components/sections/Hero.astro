---
/**
 * Abertura de página.
 * - variant="split"    → texto + imagem lado a lado (home)
 * - variant="centered" → texto centralizado, imagem larga opcional abaixo
 * - variant="page"     → cabeçalho compacto para páginas internas
 * - variant="cover"    → foto de fundo em tela cheia com degradê escuro
 */
import { Image } from 'astro:assets';
import Check from '@lucide/astro/icons/check';
import ArrowRight from '@lucide/astro/icons/arrow-right';
import Button from '../ui/Button.astro';
import Container from '../ui/Container.astro';
import Badge from '../ui/Badge.astro';
import type { ContentImage, CTA } from '../../types/content';

interface Props {
  variant?: 'split' | 'centered' | 'page' | 'cover';
  eyebrow?: string;
  title: string;
  description?: string;
  primaryCta?: CTA;
  secondaryCta?: CTA;
  image?: ContentImage;
  /** Marca a imagem como ilustrativa (exibe um selo). */
  imageIllustrative?: boolean;
  /** Lista curta de pontos (ex.: "Atendimento online"). */
  highlights?: string[];
  /** Linhas circulares finas atrás da imagem (variante split). */
  decor?: boolean;
}

const {
  variant = 'split',
  eyebrow,
  title,
  description,
  primaryCta,
  secondaryCta,
  image,
  imageIllustrative = false,
  highlights = [],
  decor = false,
} = Astro.props;

const isSplit = variant === 'split' && image;
const isCentered = variant === 'centered';
const isPage = variant === 'page';
const isCover = variant === 'cover' && image;
---

<section
  class:list={[
    'relative overflow-x-clip',
    isCover
      ? 'hero-cover flex min-h-[min(88svh,760px)] items-end pt-32 pb-16 lg:items-center lg:pb-24'
      : isPage
        ? 'border-b border-line pt-14 pb-12 lg:pt-20 lg:pb-16'
        : 'pt-12 pb-16 lg:pt-20 lg:pb-24',
  ]}
  aria-labelledby="page-title"
>
  {
    isCover && image && (
      <>
        <Image
          src={image.src}
          alt={image.alt}
          widths={[640, 1024, 1600, 2000]}
          sizes="100vw"
          loading="eager"
          fetchpriority="high"
          class="absolute inset-0 h-full w-full object-cover"
        />
        <div class="hero-cover__shade absolute inset-0" aria-hidden="true" />
      </>
    )
  }
  <Container class={isCover ? 'relative' : undefined}>
    <div class:list={[isSplit && 'grid items-center gap-12 lg:grid-cols-12 lg:gap-16']}>
      <div class:list={[isSplit && 'lg:col-span-7', isCentered && 'mx-auto max-w-3xl text-center', (isPage || isCover) && 'max-w-3xl']}>
        {eyebrow && <p class="mb-5 text-sm font-medium tracking-[0.08em] text-accent uppercase">{eyebrow}</p>}
        <h1 id="page-title" class:list={[isPage ? 'text-h2 sm:text-[clamp(2.25rem,1.6rem+2.4vw,3.5rem)]' : 'text-display']}>
          {title}
        </h1>
        {description && <p class:list={['text-lead mt-6 text-muted', isCentered ? 'mx-auto max-w-2xl' : 'max-w-xl']}>{description}</p>}

        {
          (primaryCta || secondaryCta) && (
            <div class:list={['mt-9 flex flex-col gap-3 sm:flex-row', isCentered && 'sm:justify-center']}>
              {primaryCta && (
                <Button href={primaryCta.href} size="lg" icon={ArrowRight}>
                  {primaryCta.label}
                </Button>
              )}
              {secondaryCta && (
                <Button href={secondaryCta.href} size="lg" variant="secondary">
                  {secondaryCta.label}
                </Button>
              )}
            </div>
          )
        }

        {
          highlights.length > 0 && (
            <ul class:list={['mt-10 flex flex-wrap gap-x-6 gap-y-3 text-sm text-muted', isCentered && 'justify-center']}>
              {highlights.map((h) => (
                <li class="flex items-center gap-2">
                  <Check size={16} class="text-primary" aria-hidden="true" />
                  {h}
                </li>
              ))}
            </ul>
          )
        }
      </div>

      {
        isSplit && image && (
          <figure class="relative lg:col-span-5">
            {decor && (
              <svg class="pointer-events-none absolute -right-16 -bottom-16 hidden w-[120%] text-primary sm:block" viewBox="0 0 400 400" fill="none" aria-hidden="true">
                <circle cx="200" cy="200" r="150" stroke="currentColor" stroke-opacity=".22" />
                <circle cx="200" cy="200" r="190" stroke="currentColor" stroke-opacity=".14" />
              </svg>
            )}
            <Image
              src={image.src}
              alt={image.alt}
              widths={[480, 720, 960]}
              sizes="(min-width: 1024px) 40vw, 100vw"
              loading="eager"
              fetchpriority="high"
              class="relative aspect-[4/5] w-full rounded-card object-cover"
            />
            {imageIllustrative && <Badge tone="neutral" class="absolute top-4 left-4">Imagem ilustrativa</Badge>}
          </figure>
        )
      }
    </div>

    {
      isCentered && image && (
        <figure class="relative mt-14 lg:mt-20">
          <Image
            src={image.src}
            alt={image.alt}
            widths={[640, 1024, 1440]}
            sizes="100vw"
            loading="eager"
            class="aspect-[16/9] w-full rounded-card object-cover sm:aspect-[21/9]"
          />
          {imageIllustrative && <Badge class="absolute top-4 left-4">Imagem ilustrativa</Badge>}
        </figure>
      )
    }
  </Container>
</section>

<style>
  /* Degradê para garantir contraste do texto sobre a foto (variante cover) */
  .hero-cover__shade {
    background:
      linear-gradient(to top, var(--color-bg) 0%, color-mix(in srgb, var(--color-bg) 70%, transparent) 45%, color-mix(in srgb, var(--color-bg) 35%, transparent) 100%),
      linear-gradient(to right, color-mix(in srgb, var(--color-bg) 85%, transparent) 0%, transparent 75%);
  }
</style>
