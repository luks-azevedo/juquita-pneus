---
/** Perguntas frequentes com <details> nativo (funciona sem JavaScript). */
import Plus from '@lucide/astro/icons/plus';
import Section, { type SectionTone } from '../ui/Section.astro';
import SectionHeading from '../ui/SectionHeading.astro';
import type { FAQItem } from '../../types/content';

interface Props {
  id?: string;
  tone?: SectionTone;
  eyebrow?: string;
  title: string;
  description?: string;
  items: FAQItem[];
  /** Gera dados estruturados FAQPage (use apenas uma vez por página). */
  schema?: boolean;
}

const { id = 'faq', tone = 'default', eyebrow, title, description, items, schema = true } = Astro.props;
const headingId = `${id}-title`;

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: items.map((f) => ({
    '@type': 'Question',
    name: f.question,
    acceptedAnswer: { '@type': 'Answer', text: f.answer },
  })),
};
---

<Section id={id} tone={tone} labelledby={headingId}>
  <div class="grid gap-10 lg:grid-cols-12 lg:gap-16">
    <div class="lg:col-span-4">
      <SectionHeading id={headingId} eyebrow={eyebrow} title={title} description={description} inverted={tone === 'inverted'} />
    </div>
    <div class="border-t border-line lg:col-span-8">
      {
        items.map((f) => (
          <details class="faq group border-b border-line">
            <summary class="flex cursor-pointer list-none items-center justify-between gap-6 py-6 text-lg font-medium text-ink">
              <span>{f.question}</span>
              <Plus size={20} class="shrink-0 text-muted transition-transform duration-300 group-open:rotate-45" aria-hidden="true" />
            </summary>
            <p class="max-w-2xl pr-10 pb-6 text-muted">{f.answer}</p>
          </details>
        ))
      }
    </div>
  </div>
  {schema && <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />}
</Section>

<style>
  .faq summary::-webkit-details-marker {
    display: none;
  }
</style>
