---
/**
 * Serviços.
 * - variant="grid" → cards (resumo, ideal para a home)
 * - variant="list" → linhas editoriais com detalhes e âncoras (página de serviços)
 */
import ArrowRight from '@lucide/astro/icons/arrow-right';
import Check from '@lucide/astro/icons/check';
import Section, { type SectionTone } from '../ui/Section.astro';
import SectionHeading from '../ui/SectionHeading.astro';
import Card from '../ui/Card.astro';
import Button from '../ui/Button.astro';
import type { CTA, ServiceItem } from '../../types/content';

interface Props {
  id?: string;
  tone?: SectionTone;
  eyebrow?: string;
  title: string;
  description?: string;
  items: ServiceItem[];
  variant?: 'grid' | 'list';
  /** Limita a quantidade exibida (ex.: 3 na home). */
  limit?: number;
  cta?: CTA;
}

const { id = 'servicos', tone = 'default', eyebrow, title, description, items, variant = 'grid', limit, cta } = Astro.props;
const list = limit ? items.slice(0, limit) : items;
const headingId = `${id}-title`;
// 4, 8... itens → 4 colunas; demais → 3 (evita item sozinho na última linha)
const gridCols = list.length % 4 === 0 ? 'lg:grid-cols-4' : 'lg:grid-cols-3';
---

<Section id={id} tone={tone} labelledby={headingId}>
  <div class="flex flex-col justify-between gap-6 md:flex-row md:items-end">
    <SectionHeading id={headingId} eyebrow={eyebrow} title={title} description={description} inverted={tone === 'inverted'} />
    {
      cta && variant === 'grid' && (
        <Button href={cta.href} variant="secondary" icon={ArrowRight} class="shrink-0 self-start md:self-auto">
          {cta.label}
        </Button>
      )
    }
  </div>

  {
    variant === 'grid' ? (
      <ul class:list={['mt-12 grid gap-5 sm:grid-cols-2 lg:mt-16', gridCols]} role="list">
        {list.map((s) => (
          <Card as="li" href={s.href}>
            {s.icon && <s.icon size={28} stroke-width={1.5} class="text-primary" aria-hidden="true" />}
            <h3 class="text-h3 mt-6">
              {s.href ? (
                <a href={s.href} class="card-link">
                  {s.title}
                </a>
              ) : (
                s.title
              )}
            </h3>
            <p class="mt-3 text-muted">{s.description}</p>
            {s.href && (
              <span class="mt-6 inline-flex items-center gap-1.5 text-sm font-medium text-primary" aria-hidden="true">
                Saiba mais <ArrowRight size={16} />
              </span>
            )}
          </Card>
        ))}
      </ul>
    ) : (
      <ol class="mt-12 border-t border-line lg:mt-16" role="list">
        {list.map((s, i) => (
          <li id={s.id} class="grid scroll-mt-28 gap-4 border-b border-line py-10 lg:grid-cols-12 lg:gap-10 lg:py-12">
            <div class="flex items-baseline gap-5 lg:col-span-5">
              <span class="font-heading text-sm text-muted tabular-nums">{String(i + 1).padStart(2, '0')}</span>
              <h3 class="text-h3 lg:text-[1.75rem]">{s.title}</h3>
            </div>
            <div class="lg:col-span-7">
              <p class="text-lead text-muted">{s.description}</p>
              {s.details && s.details.length > 0 && (
                <ul class="mt-5 grid gap-2 sm:grid-cols-2">
                  {s.details.map((d) => (
                    <li class="flex gap-2.5">
                      <Check size={18} class="mt-1 shrink-0 text-primary" aria-hidden="true" />
                      <span>{d}</span>
                    </li>
                  ))}
                </ul>
              )}
            </div>
          </li>
        ))}
      </ol>
    )
  }
</Section>
